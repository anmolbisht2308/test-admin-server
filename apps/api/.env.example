# Copy to .env for local dev. Every variable is validated in src/env.ts.
NODE_ENV=development
PORT=4000
LOG_LEVEL=info

# Local: docker compose up -d. Prod: MongoDB Atlas SRV string.
MONGODB_URI=mongodb://localhost:27017/mockprep
# Local: docker compose. Prod: Upstash rediss:// URL.
REDIS_URL=redis://localhost:6379

# Comma-separated list of allowed browser origins (web + admin).
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Proxies in front of the api. Local: 1 (Next dev rewrite). Render behind Vercel rewrites: 2.
TRUST_PROXY=1
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300

# Optional. Defaults to RENDER_GIT_COMMIT (short) or the package version.
APP_VERSION=

# ----- auth -----
# Long random strings. Generate with: openssl rand -base64 48
JWT_SECRET=dev-only-jwt-secret-change-me-0123456789abcdef
TOTP_ENCRYPTION_KEY=dev-only-totp-key-change-me-0123456789abcdef
ACCESS_TOKEN_TTL_SEC=900
STUDENT_REFRESH_TTL_DAYS=30
ADMIN_REFRESH_TTL_DAYS=7
STUDENT_MAX_DEVICES=2
# false for local http; defaults to true in production.
COOKIE_SECURE=false
ADMIN_TOTP_ISSUER=mockprep
# console = OTP is printed in the api log (dev). msg91 = real SMS.
OTP_PROVIDER=console
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
# Comma-separated Google OAuth client ids. Empty disables Google sign-in.
GOOGLE_CLIENT_IDS=

# ----- seed script (pnpm --filter @mockprep/api seed) -----
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=Change-Me-Please-1

# ----- email (sign-in codes; later invoices/notifications) -----
# console = emails printed in the api log (dev). brevo = real email via Brevo's free plan.
EMAIL_PROVIDER=console
BREVO_API_KEY=
# A sender address verified in Brevo (Senders & IPs), e.g. your Gmail or no-reply@yourdomain.
EMAIL_FROM=
EMAIL_FROM_NAME=mockprep

# ----- payments (Razorpay) -----
# fake = local stand-in, no keys (default in dev/test; refused in production).
# razorpay = real (test keys rzp_test_… from dashboard.razorpay.com → Account & Settings → API keys).
# none = checkout off (default in production until keys are set).
PAYMENTS_PROVIDER=fake
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Webhook: URL https://<api>/api/webhooks/razorpay, events payment.captured, payment.failed,
# refund.processed; put the secret you chose here.
RAZORPAY_WEBHOOK_SECRET=
# Invoices: numbers <prefix>/<FY>/000001; seller block printed on every invoice.
INVOICE_PREFIX=MP
SELLER_NAME=mockprep
SELLER_ADDRESS=
SELLER_GSTIN=
SELLER_STATE=
SELLER_EMAIL=

# ----- file storage (question figures) -----
# local = files on disk, served by the api at /api/files/* (dev). s3 = presigned uploads to S3.
STORAGE_DRIVER=local
LOCAL_UPLOAD_DIR=./uploads
S3_BUCKET=
S3_REGION=
# Public URL files are served from (bucket URL or CloudFront), no trailing slash.
S3_PUBLIC_BASE_URL=
# S3 credentials use the standard AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY variables.

# ----- free hosting (single Render free web service) -----
# Run the queue workers inside the api process (no separate worker service).
# PDF → test pipeline. Free key: https://aistudio.google.com/apikey (empty = text parser only).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
CHUNK_PAGES=6
RUN_WORKER_IN_API=false
WORKER_CONCURRENCY=2
# Seed templates/exams/SEED_ADMIN_EMAIL at startup (hosts without a pre-deploy step).
SEED_ON_START=false
# S3-compatible endpoint for Cloudflare R2: https://<account-id>.r2.cloudflarestorage.com
S3_ENDPOINT=
