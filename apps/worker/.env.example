# Copy to .env for local dev. Every variable is validated in src/env.ts.
NODE_ENV=development
LOG_LEVEL=info
# Local: docker compose. Prod: Upstash rediss:// URL (same one the api uses).
REDIS_URL=redis://localhost:6379
WORKER_CONCURRENCY=5
# PDF ingest: same Mongo + storage as the api (ingest is off without MONGODB_URI).
MONGODB_URI=mongodb://localhost:27017/mockprep
STORAGE_DRIVER=local
# local driver: the api's upload folder
LOCAL_UPLOAD_DIR=../api/uploads
S3_BUCKET=
S3_REGION=
S3_PUBLIC_BASE_URL=
S3_ENDPOINT=
# Free key from https://aistudio.google.com/apikey. Empty = text parser (no scanned PDFs).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
CHUNK_PAGES=6
