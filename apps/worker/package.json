{
  "name": "@mockprep/worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "fixtures": "tsx scripts/make-fixtures.ts"
  },
  "dependencies": {
    "@google/genai": "^2.24.0",
    "@mockprep/core": "workspace:*",
    "@mockprep/types": "workspace:*",
    "bullmq": "^6.3.9",
    "ioredis": "^5.8.0",
    "mongoose": "^9.10.2",
    "pdf-lib": "^1.17.1",
    "pino": "^10.3.1",
    "unpdf": "^1.8.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@mockprep/config": "workspace:*",
    "@types/node": "^22.19.0",
    "eslint": "^9.39.5",
    "pino-pretty": "^13.1.3",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "vitest": "^5.0.2"
  },
  "exports": {
    "./runtime": {
      "types": "./dist/runtime.d.ts",
      "import": "./dist/runtime.js"
    }
  }
}
